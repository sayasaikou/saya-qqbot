# Copy to .env (or set these as user-level environment variables) and edit.
# The bot reads them at startup; nothing here is a secret by itself.

# Where this bot keeps its files
QQBOT_ROOT=E:\qqbot
QQBOT_HOME=${QQBOT_ROOT}\home
QQBOT_WORK=${QQBOT_ROOT}\work
QQBOT_DATA=${QQBOT_ROOT}\data
QQBOT_TOOLS=${QQBOT_ROOT}\tools

# DSH profile directory (the bot runs as its own DSH profile)
DSH_HOME=C:\Users\<you>\.dsh
DSH_PROFILE_DIR=${DSH_HOME}\profiles\qqbot

# Credentials -- put these in FILES, not here (see set-qqbot-env.ps1)
#   <keydir>\sayask.txt        -> DEEPSEEK_API_KEY
#   <keydir>\qqbot-appid.txt   -> QQBOT_APPID
#   <keydir>\qqbot-secret.txt  -> QQBOT_SECRET
